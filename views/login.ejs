<%- include('partials/head', { title: 'Sign in — Slotline' }) %>
<%- include('partials/nav', { active: '' }) %>
<main class="wrap narrow page" style="max-width: 420px;">
  <h1>Sign in</h1>
  <% if (error) { %><div class="notice"><%= error %></div><% } %>
  <form method="post" action="/login" class="card">
    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= email %>" required autofocus />
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required />
    </div>
    <button class="btn btn-primary" type="submit">Sign in</button>
  </form>
  <p class="hint">No account? <a href="/signup">Create one</a>, or try the
    <form method="post" action="/demo-login" style="display:inline;"><button class="btn btn-sm btn-ghost" type="submit">demo account</button></form>
  </p>
</main>
</body></html>
