# Postgres. Fly.io and Railway inject this for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/slotline
PORT=3000

# Public origin, used in confirmation emails and calendar invites.
BASE_URL=http://localhost:3000

# Optional. Without it, confirmation emails are printed to the console instead
# of being sent, so everything works with no credentials at all.
RESEND_API_KEY=
MAIL_FROM=Slotline <bookings@example.com>

# Set to false to skip creating the one-click demo account on boot.
SEED_DEMO=true
# Postgres schema to keep this app's tables in. Leave unset for `public`.
# Set it when several apps share one database (Render's free tier allows only
# one), so their tables and migration history stay separate.
DB_SCHEMA=slotline
